# ─────────────────────────────────────────────
#  SUPABASE
#  Obtenha em: https://supabase.com → Settings → API
# ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────
#  SERVIDOR
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
#  CORS — domínio do seu frontend
#  Ex: https://meusite.com ou http://localhost:5500
# ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5500

# ─────────────────────────────────────────────
#  COTABOX (opcional — para integração futura)
# ─────────────────────────────────────────────
COTABOX_API_KEY=
COTABOX_API_URL=https://api.cotabox.com.br/v1

# ─────────────────────────────────────────────
#  TICKETLOG — login automático no portal legado (SouLog)
#  Com estas três variáveis o servidor renova a sessão sozinho e ninguém
#  precisa colar cURL quando ela expira. São os mesmos campos da tela de
#  login: legacy-soulog.ticketlog.com.br/autenticacao/
#  Ideal: usar um usuário dedicado à integração, para não brigar com o
#  login diário da equipe (o portal derruba a sessão anterior).
# ─────────────────────────────────────────────
TICKETLOG_CODIGO=
TICKETLOG_USUARIO=
TICKETLOG_SENHA=
# TICKETLOG_KEEPALIVE_MIN=15   # frequência do keep-alive (0 desativa)

# ─────────────────────────────────────────────
#  TICKETLOG — sessão pela Conta Edenred (SSO). ESTE é o jeito que funciona.
#  O login acima é recusado no legado ("Senha ou usuário inválido") porque o
#  acesso da equipe é pelo SSO, e a tela do SSO tem reCAPTCHA — robô não passa.
#  A saída é o REFRESH TOKEN: uma pessoa entra no navegador UMA vez (resolvendo
#  captcha e MFA) e o servidor se reconecta sozinho por ~90 dias.
#  Como capturar: COMO-CONECTAR-SSO-TICKETLOG.md
#
#  ⚠️ Esta variável é só a SEMENTE. O SSO ROTACIONA o refresh token a cada
#     renovação, e o novo é gravado em config_sistema.ticketlog_sso_refresh
#     (rodar scripts/km-sso.sql). Sem essa coluna a automação para sozinha
#     ~1h depois da primeira renovação, sem erro nenhum na tela.
# ─────────────────────────────────────────────
TICKETLOG_SSO_REFRESH=
# TICKETLOG_SSO_CLIENT_ID=fcfc49a2ff3b45ef9c5f245b37b4d567   # client do portal na Edenred
# TICKETLOG_SSO_TOKEN_URL=https://sso.sa.edenred.io/connect/token
# TICKETLOG_CLIENTE=244457     # código do cliente enviado à ponte /sso/redirect.cfm
# TICKETLOG_TIPOCARTAO=4       # idem

# ─────────────────────────────────────────────
#  E-MAIL — alerta de revisão se aproximando
#  Basta UMA das chaves abaixo + o EMAIL_FROM.
#  O resto (quem recebe, dias de antecedência, horário) é
#  configurado na tela: Próximas Revisões → 🔔 Alertas por e-mail
# ─────────────────────────────────────────────
EMAIL_FROM="Manutenção Amerinode <alertas@amerinode.com.br>"
RESEND_API_KEY=
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_PROVIDER=resend        # força o provedor (resend|brevo|sendgrid)
# ALERTA_REVISAO_TICK_MIN=20   # frequência da checagem do agendador (0 desativa)
# ALERTA_TZ=America/Sao_Paulo  # fuso usado no horário do disparo
